# Root .env.example — copy to .env and fill in values.
# This variant is for running everything via docker-compose (Postgres + Redis in containers).

# --- Postgres ---
POSTGRES_USER=reports
POSTGRES_PASSWORD=reports
POSTGRES_DB=reports
DATABASE_URL=postgresql+asyncpg://reports:reports@postgres:5432/reports
DATABASE_URL_SYNC=postgresql://reports:reports@postgres:5432/reports

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
JWT_SECRET=change-me
JWT_EXPIRES_DAYS=30

# --- Credential encryption (generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())") ---
CREDENTIALS_ENCRYPTION_KEY=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
OPENAI_STT_MODEL=whisper-1

# --- OCR (LLMWhisperer) ---
# Public v1 endpoint by default; for v2 use your region URL, e.g.:
#   US: https://llmwhisperer-api.us-central.unstract.com/api/v2
#   EU: https://llmwhisperer-api.eu-west.unstract.com/api/v2
LLMWHISPERER_BASE_URL=https://llmwhisperer-api.us-central.unstract.com/api/v2
LLMWHISPERER_API_KEY=

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:3000
HOST=0.0.0.0
PORT=8000
